# Skopiuj do server/.env i uzupełnij.

# Klucz do podpisywania tokenów JWT. Wygeneruj np.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Domyślnie: sqlite w server/db/database.db
# DATABASE_URL=sqlite:///C:/sciezka/do/database.db

CORS_ORIGINS=http://localhost:3000

# --- Konta ---
# false = rejestracja wyłączona, logujesz się tylko kontem głównym poniżej.
# true  = każdy może założyć konto (formularz rejestracji pojawi się w UI).
ALLOW_REGISTRATION=false

# Konto główne (admin). Tworzone przy starcie, jeśli nie istnieje.
# Jeśli użytkownik o tej nazwie już istnieje, dostaje uprawnienia admina (hasło się nie zmienia).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Ceny ---
QUOTE_CURRENCY=USDT
# Jak długo ceny w cache są uznawane za świeże (sekundy).
PRICE_TTL_SECONDS=180
# Minimalny odstęp między wymuszonymi odświeżeniami ("Odśwież ceny").
PRICE_FORCE_MIN_INTERVAL_SECONDS=10
# Po błędzie giełdy: ile sekund czekać przed kolejną próbą.
PRICE_ERROR_BACKOFF_SECONDS=30
PRICE_HTTP_TIMEOUT_SECONDS=10
