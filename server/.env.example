# Copy to server/.env and fill in.

# Key used to sign JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default: SQLite in server/db/database.db
# DATABASE_URL=sqlite:///C:/path/to/database.db

CORS_ORIGINS=http://localhost:3000

# --- Accounts ---
# false = registration disabled, only the main account below can log in.
# true  = anyone can create an account (the registration form appears in the UI).
ALLOW_REGISTRATION=false

# Main (admin) account. Created on startup if it doesn't exist.
# If a user with this name already exists, it gets admin rights (password unchanged).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Prices ---
QUOTE_CURRENCY=USDT
# How long cached prices are considered fresh (seconds).
PRICE_TTL_SECONDS=180
# Minimum interval between forced refreshes ("Refresh prices" button).
PRICE_FORCE_MIN_INTERVAL_SECONDS=10
# After an exchange error: seconds to wait before the next attempt.
PRICE_ERROR_BACKOFF_SECONDS=30
PRICE_HTTP_TIMEOUT_SECONDS=10

# --- Time ---
# Time zone of purchase/sale dates entered in the UI (IANA name).
USER_TIMEZONE=Europe/Warsaw

# --- Alerts ---
# Seconds between alert checks (0 = disabled).
ALERT_CHECK_SECONDS=60
